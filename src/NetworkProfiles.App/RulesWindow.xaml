<Window x:Class="NetworkProfiles.App.RulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NetworkProfiles.App.ViewModels"
        xmlns:app="clr-namespace:NetworkProfiles.App"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Auto-switch"
        Icon="Assets/app.ico"
        Width="760" Height="560" MinWidth="620" MinHeight="400"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Auto-switch" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0">
                <Run Text="While a program runs, its profile is applied to the adapter chosen in the rule. When it closes, the previous settings come back. If several programs run, the first rule in the list wins. Network Profiles has to be running (it can sit in the tray)." />
            </TextBlock>
            <CheckBox Content="Switch profiles automatically" IsChecked="{Binding AutoSwitchEnabled}" Margin="0,16,0,0" />
            <CheckBox Content="Start Network Profiles in the tray when I sign in" IsChecked="{Binding StartWithWindows}" Margin="0,8,0,16" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Add rule" Command="{Binding AddRuleEntryCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="16,6" />
        </StackPanel>

        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" app:WheelScroll.IsEnabled="True">
                <ItemsControl ItemsSource="{Binding Rules}" x:Name="RuleList" IsEnabled="{Binding AutoSwitchEnabled}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RuleViewModel}">
                            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" ToolTip="Rule on or off" MinWidth="0" />
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding Program, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                                                 ToolTip="Program file name, for example game.exe" />
                                        <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Padding="10,4" VerticalAlignment="Center"
                                                Command="{Binding DataContext.BrowseProgramCommand, ElementName=RuleList}" CommandParameter="{Binding}" />
                                    </Grid>
                                    <TextBlock Grid.Column="2" Text="Active" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                               Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Grid.Column="3" Content="✕" Margin="12,0,0,0" Padding="10,4" VerticalAlignment="Center" ToolTip="Delete this rule"
                                            Command="{Binding DataContext.RemoveRuleCommand, ElementName=RuleList}" CommandParameter="{Binding}" />

                                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Use" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox Grid.Column="1" VerticalAlignment="Center"
                                                  ItemsSource="{Binding DataContext.Profiles, ElementName=RuleList}"
                                                  DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ProfileId}"
                                                  ToolTip="Profile to use while the program runs" />
                                        <TextBlock Grid.Column="2" Text="on" VerticalAlignment="Center" Margin="12,0,8,0" />
                                        <ComboBox Grid.Column="3" VerticalAlignment="Center"
                                                  ItemsSource="{Binding DataContext.AdapterChoices, ElementName=RuleList}"
                                                  DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding AdapterId}"
                                                  ToolTip="Adapter to change while the program runs" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="No rules yet. Add one to switch profiles when a program starts."
                       Style="{StaticResource Caption}" Margin="4" VerticalAlignment="Top">
                <TextBlock.Visibility>
                    <Binding Path="Rules.Count">
                        <Binding.Converter>
                            <vm:ZeroToVisibleConverter />
                        </Binding.Converter>
                    </Binding>
                </TextBlock.Visibility>
            </TextBlock>
        </Grid>
    </DockPanel>
</Window>
