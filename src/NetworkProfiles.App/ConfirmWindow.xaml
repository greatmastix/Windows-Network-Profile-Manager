<Window x:Class="NetworkProfiles.App.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="MessageText" Margin="0,12,0,0" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="OK" Click="OnOk" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" MinWidth="96" Padding="16,6" />
            <Button Content="Cancel" IsCancel="True" Margin="8,0,0,0" MinWidth="96" Padding="16,6" />
        </StackPanel>
    </StackPanel>
</Window>
