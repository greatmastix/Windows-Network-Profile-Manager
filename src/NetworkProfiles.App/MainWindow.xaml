<Window x:Class="NetworkProfiles.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NetworkProfiles.App.ViewModels"
        xmlns:app="clr-namespace:NetworkProfiles.App"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Network Profiles"
        Width="1040" Height="720" MinWidth="820" MinHeight="560"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Profile list -->
        <DockPanel Grid.Column="0" Margin="16,16,8,16">
            <TextBlock DockPanel.Dock="Top" Text="Profiles" FontSize="20" FontWeight="SemiBold" Margin="4,0,0,12" />

            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Content="New" Command="{Binding NewProfileCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="16,6" />
                    <Button Content="Duplicate" Command="{Binding DuplicateProfileCommand}" Margin="8,0,0,0" Padding="12,6" />
                    <Button Content="Delete" Command="{Binding DeleteProfileCommand}" Margin="8,0,0,0" Padding="12,6" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Import…" Command="{Binding ImportProfilesCommand}" Padding="12,6" ToolTip="Add profiles from an exported file" />
                    <Button Content="Export…" Command="{Binding ExportProfilesCommand}" Margin="8,0,0,0" Padding="12,6" ToolTip="Save all profiles to a file" />
                    <Button Content="Auto-switch…" Click="OnOpenRules" Margin="8,0,0,0" Padding="12,6" ToolTip="Switch profiles when programs start" />
                </StackPanel>
            </StackPanel>

            <Grid>
                <ListBox ItemsSource="{Binding Profiles}"
                         SelectedItem="{Binding SelectedProfile}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="False"
                         app:WheelScroll.IsEnabled="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProfileViewModel}">
                            <StackPanel Margin="4,6">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="No profiles yet. Create one, or capture the current settings of an adapter."
                           Style="{StaticResource Caption}" Margin="12" VerticalAlignment="Top">
                    <TextBlock.Visibility>
                        <Binding Path="Profiles.Count">
                            <Binding.Converter>
                                <vm:ZeroToVisibleConverter />
                            </Binding.Converter>
                        </Binding>
                    </TextBlock.Visibility>
                </TextBlock>
            </Grid>
        </DockPanel>

        <DockPanel Grid.Column="1" Margin="8,16,16,16">

            <!-- Apply bar -->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,4,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Adapter" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}" MinWidth="240">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Style="{StaticResource Caption}">
                                        <Run Text="{Binding Summary, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Description, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                        <Button Content="Refresh" Command="{Binding RefreshAdaptersCommand}" Padding="12,6" ToolTip="Reload the adapter list" />
                        <Button Content="Save current as profile" Command="{Binding CaptureFromAdapterCommand}" Margin="8,0,0,0" Padding="12,6"
                                ToolTip="Create a new profile from this adapter's current settings" />
                        <Button Content="Apply profile" Command="{Binding ApplyCommand}" Style="{DynamicResource AccentButtonStyle}" Margin="8,0,0,0" Padding="20,6" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0" Style="{StaticResource Caption}"
                               Text="{Binding SelectedAdapter.Details, FallbackValue=''}" />

                    <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding ServiceStatus}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ServiceMissing}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="{Binding StatusMessage}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Profile editor -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" app:WheelScroll.IsEnabled="True"
                          Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                <StackPanel DataContext="{Binding SelectedProfile}" Margin="0,0,8,0" d:DataContext="{d:DesignInstance Type=vm:ProfileViewModel}">

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Profile" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="IP address" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="One or more IPv4 addresses and a default gateway. The first address is the primary one." Style="{StaticResource Caption}" />
                            <ComboBox ItemsSource="{x:Static vm:ProfileViewModel.Ipv4Modes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding Ipv4Mode}" Margin="0,12,0,0" MinWidth="220" HorizontalAlignment="Left" />
                            <StackPanel Visibility="{Binding IsIpv4Manual, Converter={StaticResource BoolToVisibility}}">
                                <Grid Margin="0,12,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="44" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="IP address" />
                                    <TextBlock Grid.Column="2" Text="Subnet mask or prefix" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Addresses}" x:Name="AddressList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:AddressEntryViewModel}">
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="44" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBox Grid.Column="2" Text="{Binding SubnetMask, UpdateSourceTrigger=PropertyChanged}" ToolTip="255.255.255.0 or 24" />
                                                <Button Grid.Column="3" Content="✕" HorizontalAlignment="Right" Padding="10,4" ToolTip="Remove this address"
                                                        Command="{Binding DataContext.RemoveAddressCommand, ElementName=AddressList}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="Add address" Command="{Binding AddAddressCommand}" HorizontalAlignment="Left" Padding="12,6" />
                                <TextBlock Text="Gateway (optional)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Gateway, UpdateSourceTrigger=PropertyChanged}" MaxWidth="320" HorizontalAlignment="Left" MinWidth="240" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="DNS" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Name servers, in the order they should be asked." Style="{StaticResource Caption}" />
                            <ComboBox ItemsSource="{x:Static vm:ProfileViewModel.DnsModes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding DnsMode}" Margin="0,12,0,0" MinWidth="220" HorizontalAlignment="Left" />
                            <StackPanel Visibility="{Binding IsDnsManual, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="DNS servers (comma separated)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding DnsServers, UpdateSourceTrigger=PropertyChanged}" ToolTip="For example 1.1.1.1, 8.8.8.8" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Proxy" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="The Windows proxy belongs to your user account, so it applies to every adapter." Style="{StaticResource Caption}" />
                            <ComboBox ItemsSource="{x:Static vm:ProfileViewModel.ProxyModes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding ProxyMode}" Margin="0,12,0,0" MinWidth="220" HorizontalAlignment="Left" />
                            <StackPanel Visibility="{Binding IsProxyManual, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Proxy server" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding ProxyServer, UpdateSourceTrigger=PropertyChanged}" ToolTip="host:port, for example proxy.example.com:8080" />
                                <TextBlock Text="Don't use the proxy for (separate with semicolons)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding ProxyBypassList, UpdateSourceTrigger=PropertyChanged}" ToolTip="*.example.com;10.*" />
                                <CheckBox Content="Don't use the proxy for local (intranet) addresses" IsChecked="{Binding ProxyBypassLocal}" Margin="0,12,0,0" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsProxyAutoConfig, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Script address" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding ProxyAutoConfigUrl, UpdateSourceTrigger=PropertyChanged}" ToolTip="For example http://wpad/wpad.dat" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Errors}" Margin="4,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
