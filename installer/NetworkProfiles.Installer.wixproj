<Project Sdk="WixToolset.Sdk/6.0.2">

  <!-- Builds NetworkProfilesSetup.msi from the single-file executables in ..\publish.
       Publish both projects first, or run ..\build-release.ps1 which does everything. -->
  <PropertyGroup>
    <OutputName>NetworkProfilesSetup</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- Override with -p:ProductVersion=1.2.3 (the CI workflow does this for v* tags). -->
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.0</ProductVersion>
    <PayloadDir>$(MSBuildThisFileDirectory)..\publish\</PayloadDir>
    <DefineConstants>ProductVersion=$(ProductVersion);PayloadDir=$(PayloadDir);IconFile=$(MSBuildThisFileDirectory)..\src\NetworkProfiles.App\Assets\app.ico</DefineConstants>
  </PropertyGroup>

</Project>
